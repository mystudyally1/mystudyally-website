# Public — bundled into the static HTML at build time. Safe to expose.
# Live Worker, until forms.mystudyally.com custom domain route is added:
NEXT_PUBLIC_FORM_ENDPOINT=https://mystudyally-forms-worker.mystudyally1.workers.dev/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GA4 measurement ID (optional at launch)
NEXT_PUBLIC_GA4_ID=

# Search Console / Bing Webmaster ownership tokens (optional).
# Leave blank until the property is verified — the meta tag is only emitted when
# a value is set, and a wrong token is worse than no tag at all.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

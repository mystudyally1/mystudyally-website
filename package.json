{
  "name": "mystudyally-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/gen-llms-txt.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:content": "node scripts/audit.mjs",
    "audit:links": "node scripts/linkcheck.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run audit:content && npm run audit:links && npm run audit:css && npm run audit:seo",
    "audit:css": "node scripts/classcheck.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "audit:behaviour": "node scripts/audit-behaviour.mjs",
    "audit:mobile": "node scripts/audit-design.mjs",
    "audit:desktop": "node scripts/audit-design.mjs --desktop",
    "audit:sections": "node scripts/audit-mobile-sections.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "audit:seo:selftest": "node scripts/seo-audit-selftest.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}

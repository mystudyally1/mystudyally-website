{
  "name": "mystudyally-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-segment-prefetch.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:content": "node scripts/audit.mjs",
    "audit:links": "node scripts/linkcheck.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run audit:content && npm run audit:links && npm run audit:css",
    "audit:css": "node scripts/classcheck.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "audit:behaviour": "node scripts/audit-behaviour.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
